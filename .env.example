# ---------------------------------------------------------------------------
# MemoSphere environment configuration
#
# Copy this file to `.env.local` and fill in the values for the services you
# want to enable. The application runs fully on mock/demo data when nothing is
# configured, so you can start with an empty file and add services as needed.
# ---------------------------------------------------------------------------

# Core
# Public base URL of the app (used for absolute links / redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI providers
# All AI features go through the centralized AI service layer (lib/services/ai).
# Gemini is the default. Set AI_PROVIDER to switch the active provider.
# The app works completely with only Gemini configured.
# ---------------------------------------------------------------------------

# Active AI provider: gemini | openai | claude  (default: gemini)
AI_PROVIDER=gemini

# Google Gemini (DEFAULT provider) — required for live AI when AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI (optional) — required when AI_PROVIDER=openai
OPENAI_API_KEY=

# Anthropic Claude (optional) — required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Amazon DynamoDB (persistence)
# When these are set, repositories read/write live DynamoDB items; otherwise
# they serve the in-memory demo data. Provision the tables in db/tables.ts and
# load demo data with `npx tsx scripts/seed-dynamodb.ts`.
# ---------------------------------------------------------------------------

# AWS region for DynamoDB (e.g. us-east-1)
AWS_REGION=

# IAM credentials with DynamoDB access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prefix applied to every DynamoDB table name (e.g. memosphere_)
AWS_DYNAMODB_TABLE_PREFIX=memosphere_

# ---------------------------------------------------------------------------
# Amazon S3 (document storage)
# Stores uploaded PDFs / slides / images. Region and credentials fall back to
# the AWS_* values above when the AWS_S3_* equivalents are omitted.
# ---------------------------------------------------------------------------

# S3 bucket for uploaded documents
AWS_S3_BUCKET_NAME=

# S3 region (falls back to AWS_REGION when unset)
AWS_S3_REGION=

# S3-specific IAM credentials (fall back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
